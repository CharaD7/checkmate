{
  "name": "checkmate",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "docker compose up -d --build postgres backend && pnpm --filter @checkmate/frontend dev",
    "dev:backend": "pnpm --filter @checkmate/backend dev",
    "dev:frontend": "pnpm --filter @checkmate/frontend dev",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint"
  }
}
